# Vertical-strip navigation and consume/expel bindings. Existing DMS
# directional focus and window-management bindings remain unchanged.
bind=SUPER,bracketleft,scroller_stack,up
bind=SUPER,bracketright,scroller_stack,down
bind=SUPER+SHIFT,bracketleft,scroller_stack,left
bind=SUPER+SHIFT,bracketright,scroller_stack,right
bind=SUPER+CTRL,H,exchange_client,left
bind=SUPER+CTRL,L,exchange_client,right
bind=SUPER+CTRL,K,exchange_client,up
bind=SUPER+CTRL,J,exchange_client,down
bind=SUPER+CTRL,p,switch_proportion_preset
bind=SUPER,u,viewtoright
bind=SUPER,i,viewtoleft
bind=SUPER+CTRL,u,tagtoright
bind=SUPER+CTRL,i,tagtoleft

# Hot-reload the mango config without restarting the session.
# The system config (/etc/mango/config.conf) ships SUPER+r for this, but our
# user config never sources that file, so the bind never reaches mango.
bind=SUPER,r,reload_config
